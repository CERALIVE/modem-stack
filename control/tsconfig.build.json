{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src"],
	"exclude": [
		"src/**/*.test.ts",
		"src/**/*.type-test.ts",
		"src/transport/test-support",
		"dist",
		"fixtures"
	]
}
